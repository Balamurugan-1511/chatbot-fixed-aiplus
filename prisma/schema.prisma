generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                     Int                @id @default(autoincrement())
  first_name             String             @default("")
  last_name              String             @default("")
  name                   String
  email                  String             @unique
  password_hash          String
  role                   String
  org                    String?
  phone                  String?
  photo_url              String?            @db.Text
  education              String?
  dob                    String?
  gender                 String?
  created_at             DateTime           @default(now())
  reset_token            String?            @unique
  reset_token_expiry     DateTime?
  blogs                  Blog[]
  enrollments            Enrollment[]
  payment_status_changes PaymentStatusLog[]
  reviews                Review[]
  saved_jobs             SavedJob[]

  @@map("users")
}

model Course {
  id               Int              @id @default(autoincrement())
  slug             String           @unique
  title            String
  category         String
  course_type      String           @default("training")
  description      String?          @db.Text
  href             String?
  duration         String?
  level            String?
  price            Decimal          @db.Decimal(10, 2)
  is_active        Boolean          @default(true)
  cover_image_url  String?          @db.Text
  long_description Json?
  what_you_learn   Json?
  curriculum       Json?
  tools            Json?
  prerequisites    Json?
  who_is_this_for  Json?
  duration_days    Int?             @default(30)
  value_pitch      String?          @db.Text
  batches          Batch[]
  materials        CourseMaterial[]
  enquiries        Enquiry[]
  enrollments      Enrollment[]
  reviews          Review[]

  @@map("courses")
}

model CourseMaterial {
  id          Int      @id @default(autoincrement())
  course_id   Int
  title       String
  type        String
  file_url    String   @db.Text
  sort_order  Int      @default(0)
  uploaded_at DateTime @default(now())
  course      Course   @relation(fields: [course_id], references: [id])

  @@index([course_id])
  @@map("course_materials")
}

model Enrollment {
  id               Int                @id @default(autoincrement())
  user_id          Int
  course_id        Int
  payment_status   String             @default("pending")
  amount_total     Decimal?           @db.Decimal(10, 2)
  amount_paid      Decimal            @default(0.00) @db.Decimal(10, 2)
  utr              String?            @unique
  enrolled_at      DateTime           @default(now())
  verified_at      DateTime?
  next_due_at      DateTime?
  status           String             @default("ongoing")
  start_date       DateTime?
  expires_at       DateTime?
  reminder_sent_at DateTime?
  course           Course             @relation(fields: [course_id], references: [id])
  user             User               @relation(fields: [user_id], references: [id])
  status_logs      PaymentStatusLog[]

  @@index([user_id])
  @@index([course_id])
  @@index([status, expires_at])
  @@map("enrollments")
}

model PaymentStatusLog {
  id            Int        @id @default(autoincrement())
  enrollment_id Int
  admin_id      Int?
  admin_name    String
  from_status   String?
  to_status     String
  amount_paid   Decimal    @db.Decimal(10, 2)
  note          String?    @db.Text
  created_at    DateTime   @default(now())
  admin         User?      @relation(fields: [admin_id], references: [id])
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [id])

  @@index([enrollment_id])
  @@index([admin_id])
  @@map("payment_status_logs")
}

model Enquiry {
  id         Int      @id @default(autoincrement())
  course_id  Int?
  name       String
  email      String
  phone      String?
  message    String   @db.Text
  status     String   @default("new")
  created_at DateTime @default(now())
  course     Course?  @relation(fields: [course_id], references: [id])

  @@index([course_id])
  @@map("enquiries")
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  course_id  Int
  rating     Int
  comment    String?  @db.Text
  created_at DateTime @default(now())
  course     Course   @relation(fields: [course_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([course_id])
  @@map("reviews")
}

model Blog {
  id           Int      @id @default(autoincrement())
  author_id    Int
  slug         String   @unique
  title        String
  category     String?
  excerpt      String?  @db.Text
  body         String   @db.LongText
  image_url    String?  @db.Text
  image_alt    String?
  status       String   @default("published")
  published_at DateTime @default(now())
  author       User     @relation(fields: [author_id], references: [id])

  @@index([author_id])
  @@map("blogs")
}

model Job {
  id               Int              @id @default(autoincrement())
  title            String
  department       String?
  location         String?
  work_mode        String?
  employment_type  String?          @default("Full-time")
  experience_level String?
  description      String?          @db.Text
  requirements     Json?
  is_active        Boolean          @default(true)
  applications     JobApplication[]
  saved_by         SavedJob[]

  @@map("jobs")
}

model SavedJob {
  id       Int      @id @default(autoincrement())
  user_id  Int
  job_id   Int
  saved_at DateTime @default(now())
  job      Job      @relation(fields: [job_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, job_id])
  @@index([job_id])
  @@map("saved_jobs")
}

model JobApplication {
  id         Int      @id @default(autoincrement())
  job_id     Int?
  job_title  String?
  name       String
  email      String
  phone      String?
  resume_url String?  @db.Text
  status     String   @default("new")
  applied_at DateTime @default(now())
  job        Job?     @relation(fields: [job_id], references: [id])

  @@index([job_id])
  @@map("job_applications")
}

model RateLimit {
  key      String   @id
  count    Int      @default(0)
  reset_at DateTime

  @@index([reset_at])
  @@map("rate_limits")
}

model LoginAttempt {
  email           String    @id
  fail_count      Int       @default(0)
  locked_until    DateTime?
  next_attempt_at DateTime?
  updated_at      DateTime  @default(now()) @updatedAt

  @@map("login_attempts")
}

model Batch {
  id         Int      @id @default(autoincrement())
  course_id  Int
  start_date DateTime
  mode       String   @default("online")
  timing     String?
  seats_left Int?
  status     String   @default("upcoming")
  note       String?
  created_at DateTime @default(now())
  course     Course   @relation(fields: [course_id], references: [id])

  @@index([course_id, start_date])
  @@map("batches")
}

model Counselor {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  is_active Boolean   @default(true)
  handoffs  Handoff[]

  @@map("counselors")
}

model ChatSession {
  id         Int           @id @default(autoincrement())
  token      String        @unique @db.VarChar(64)
  channel    String        @default("web")
  ip         String?
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt
  messages   ChatMessage[]
  handoffs   Handoff[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         Int         @id @default(autoincrement())
  session_id Int
  role       String
  content    String      @db.Text
  created_at DateTime    @default(now())
  session    ChatSession @relation(fields: [session_id], references: [id])

  @@index([session_id, id])
  @@map("chat_messages")
}

model Handoff {
  id           Int         @id @default(autoincrement())
  session_id   Int
  reason       String
  summary      String?     @db.Text
  name         String?
  phone        String?
  status       String      @default("new")
  counselor_id Int?
  created_at   DateTime    @default(now())
  counselor    Counselor?  @relation(fields: [counselor_id], references: [id])
  session      ChatSession @relation(fields: [session_id], references: [id])

  @@index([status, created_at])
  @@index([session_id])
  @@index([counselor_id])
  @@map("handoffs")
}
